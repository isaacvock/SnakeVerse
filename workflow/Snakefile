from pathlib import Path
import importlib.util
import sys

configfile: "config/config.yaml"

container: "docker://docker.io/isaacvock/snakeverse-base:0.1.0"

###############################################################################################################
# STEP 1: WORK REALLY HARD TO BE ABLE TO LOAD THE FUNCTIONS IN `workflow/lib` no matter how the pipeline is run
###############################################################################################################

# Gotta figure out where the workflow is, or where it's cached version is
# if we are working with a remote deployment.
if hasattr(workflow, "source_path"):
    WORKFLOW_DIR = Path(workflow.source_path("Snakefile")).resolve().parent
    workflow_file = lambda path: str(Path(workflow.source_path(path)).resolve())
else:
    WORKFLOW_DIR = Path("workflow").resolve()
    workflow_file = lambda path: str((WORKFLOW_DIR / path).resolve())


# Figure out where are the scripts are that provide functions used
# by this workflow
WORKFLOW_LIB_DIR = Path(workflow_file("lib/config.py")).parent

# Can't totally remember why I had to do this, but
# idea is that by moving this path to the top of the searched
# paths, you can oft avoid importing the incorrect module
# from a similarly named script/path
sys.path.insert(0, str(WORKFLOW_LIB_DIR))

# Everything that can be loaded as a module
WORKFLOW_LIB_MODULES = [
    ("snakeverse_config", "lib/config.py"),
    ("samples", "lib/samples.py"),
    ("refs", "lib/refs.py"),
    ("params", "lib/params.py"),
    ("tracks", "lib/tracks.py"),
    ("validation", "lib/validation.py"),
]

# Never had to work so hard to just load a module, but here we are
for module_name, module_path in WORKFLOW_LIB_MODULES:
    source_path = workflow_file(module_path)
    spec = importlib.util.spec_from_file_location(module_name, source_path)
    if spec is None or spec.loader is None:
        raise ImportError(f"Could not import workflow module {module_name} from {source_path}")
    loaded_workflow_module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = loaded_workflow_module
    spec.loader.exec_module(loaded_workflow_module)

snakeverse_config = sys.modules["snakeverse_config"]
get_results_dir = snakeverse_config.get_results_dir
resolve_config_from_mapping = snakeverse_config.resolve_config_from_mapping

from samples import (
    alignment_fastq_1,
    alignment_fastq_2,
    bam_qc_targets,
    bigwig_targets,
    filtered_bam_targets,
    fastqc_targets,
    has_sra_samples,
    load_samples,
    markdup_bam_targets,
    raw_bam_targets,
    sample_ids,
    transcriptome_bam_targets,
    trimmed_fastq_targets,
)
from refs import genome_slug
from validation import validate_resolved_config


RESOLVED_CONFIG = resolve_config_from_mapping(config)
config.update(RESOLVED_CONFIG)

RESULTS_DIR = get_results_dir(config)
PROJECT_ROOT = config["_ngsflow"]["project_root"]
SAMPLES = load_samples(config["samples"], config["assay"], PROJECT_ROOT)
SAMPLE_IDS = sample_ids(SAMPLES)
GENOME_SLUG = genome_slug(config)

VALIDATION_ERRORS, VALIDATION_WARNINGS = validate_resolved_config(config, SAMPLES)
if VALIDATION_ERRORS:
    raise ValueError(
        "SnakeVerse config validation failed:\n  - "
        + "\n  - ".join(VALIDATION_ERRORS)
    )
for warning in VALIDATION_WARNINGS:
    print(f"SnakeVerse warning: {warning}")


module_settings = lambda name: snakeverse_config.module_config(config, name)
module_enabled = lambda name: snakeverse_config.module_enabled(config, name)
module_tool = lambda name, default="": snakeverse_config.module_tool(config, name, default)
gene_count_mode_enabled = lambda name: module_enabled("gene_counts") and bool(
    module_settings("gene_counts").get("modes", {}).get(name, False)
)
trimming_for_alignment = lambda: module_enabled("trimming")
TRIMMING_TOOL = module_tool("trimming", "fastp")
salmon_quant_enabled = lambda: module_enabled("salmon_quantification")
rsem_quant_enabled = lambda: module_enabled("rsem_quantification")
salmon_result_enabled = lambda name: salmon_quant_enabled() and bool(
    module_settings("salmon_quantification").get(name, True)
)
rsem_result_enabled = lambda name: rsem_quant_enabled() and bool(
    module_settings("rsem_quantification").get(name, True)
)
needs_transcriptome_bam = lambda: bool(
    module_settings("alignment").get("transcriptome_bam", False)
) or salmon_quant_enabled() or rsem_quant_enabled()

raw_bam_path = lambda sample: f"{RESULTS_DIR}/bam/raw/{sample}.bam"
raw_bai_path = lambda sample: f"{RESULTS_DIR}/bam/raw/{sample}.bam.bai"
markdup_bam_path = lambda sample: f"{RESULTS_DIR}/bam/markdup/{sample}.bam"
markdup_bai_path = lambda sample: f"{RESULTS_DIR}/bam/markdup/{sample}.bam.bai"
filtered_bam_path = lambda sample: f"{RESULTS_DIR}/bam/filtered/{sample}.bam"
filtered_bai_path = lambda sample: f"{RESULTS_DIR}/bam/filtered/{sample}.bam.bai"
pre_filter_bam_path = lambda sample: (
    markdup_bam_path(sample) if module_enabled("mark_duplicates") else raw_bam_path(sample)
)
pre_filter_bai_path = lambda sample: (
    markdup_bai_path(sample) if module_enabled("mark_duplicates") else raw_bai_path(sample)
)
final_bam_path = lambda sample: (
    filtered_bam_path(sample) if module_enabled("bam_filter") else pre_filter_bam_path(sample)
)
final_bai_path = lambda sample: (
    filtered_bai_path(sample) if module_enabled("bam_filter") else pre_filter_bai_path(sample)
)

alignment_r1 = lambda wildcards: alignment_fastq_1(
    SAMPLES, wildcards.sample, RESULTS_DIR, trimming_for_alignment()
)
alignment_r2 = lambda wildcards: alignment_fastq_2(
    SAMPLES, wildcards.sample, RESULTS_DIR, trimming_for_alignment()
)


ASSAY_TARGETS = []
MULTIQC_INPUTS = []


rule all:
    input:
        lambda wildcards: ASSAY_TARGETS


if module_enabled("sra_download") and has_sra_samples(SAMPLES):
    include: workflow_file("rules/common/sra_download.smk")

include: workflow_file("rules/common/fastq_qc.smk")

if module_enabled("trimming"):
    include: workflow_file("rules/common/trimming.smk")

ALIGNER = module_tool("alignment")
if ALIGNER == "bowtie2":
    include: workflow_file("rules/common/index_bowtie2.smk")
    include: workflow_file("rules/common/align_bowtie2.smk")
elif ALIGNER == "star":
    include: workflow_file("rules/common/index_star.smk")
    include: workflow_file("rules/common/align_star.smk")
elif ALIGNER == "bwa_mem2":
    include: workflow_file("rules/common/index_bwa_mem2.smk")
    include: workflow_file("rules/common/align_bwa_mem2.smk")
else:
    raise ValueError(f"Unsupported or missing alignment.tool: {ALIGNER}")

include: workflow_file("rules/common/bam_filter.smk")
include: workflow_file("rules/common/mark_duplicates.smk")
include: workflow_file("rules/common/bam_qc.smk")
include: workflow_file("rules/common/coverage.smk")
include: workflow_file("rules/common/multiqc.smk")

if config["assay"] == "generic":
    include: workflow_file("rules/assays/generic.smk")
elif config["assay"] == "rnaseq":
    include: workflow_file("rules/assays/rnaseq.smk")
elif config["assay"] == "atacseq":
    include: workflow_file("rules/assays/atacseq.smk")
else:
    raise ValueError(f"Unsupported assay: {config['assay']}")
